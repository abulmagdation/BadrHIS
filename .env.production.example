# Reference values only. Set secrets in Cloud Run / Secret Manager, not GitHub.
NODE_ENV=production
HOST=0.0.0.0
# Cloud Run supplies PORT; do not configure it as an environment variable there.
PORT=8080
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=badr_his
# Generate a random secret of at least 32 characters; used only for first admin setup.
SETUP_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Optional: exact site origin. Without it, HTTPS same-origin requests are accepted.
# APP_ORIGIN=https://YOUR_SERVICE.run.app
